-- star/win/cloud = tingkat visibilitas 0..1
local THEMES = {
    { -- SIANG
        top = Color3.fromRGB(60, 150, 255), bot = Color3.fromRGB(175, 228, 255),
        body = Color3.fromRGB(255, 238, 110), bx = 0.68, by = 8,
        bld = Color3.fromRGB(75, 90, 125), road = Color3.fromRGB(62, 64, 72),
        star = 0, win = 0, cloud = 0.9, cloudCol = Color3.fromRGB(255, 255, 255),
    },
    { -- SORE
        top = Color3.fromRGB(110, 55, 130), bot = Color3.fromRGB(255, 145, 70),
        body = Color3.fromRGB(255, 185, 80), bx = 0.78, by = 46,
        bld = Color3.fromRGB(50, 28, 60), road = Color3.fromRGB(46, 38, 50),
        star = 0.3, win = 0.6, cloud = 0.6, cloudCol = Color3.fromRGB(255, 185, 150),
    },
    { -- MALAM
        top = Color3.fromRGB(45, 10, 90), bot = Color3.fromRGB(10, 20, 60),
        body = Color3.fromRGB(255, 245, 200), bx = 0.78, by = 26,
        bld = Color3.fromRGB(18, 14, 35), road = Color3.fromRGB(28, 28, 36),
        star = 1, win = 1, cloud = 0, cloudCol = Color3.fromRGB(120, 110, 160),
    },
}
local HOLD, BLEND = 12, 6 -- tiap tema tahan 12 detik, transisi 6 detik
local CYCLE = HOLD + BLEND

local function lerpN(a, b, k) return a + (b - a) * k end

-- ===== LOOP ANIMASI (auto berhenti pas GUI dihancurin) =====
local t0 = os.clock()
local animConn
animConn = RunService.RenderStepped:Connect(function()
    if not gui.Parent then animConn:Disconnect() return end
    local t = os.clock() - t0

    -- hitung tema sekarang (blend antar tema)
    local idx = math.floor(t / CYCLE) % #THEMES
    local k = math.clamp(((t % CYCLE) - HOLD) / BLEND, 0, 1)
    k = k * k * (3 - 2 * k) -- smoothstep
    local A = THEMES[idx + 1]
    local B = THEMES[(idx + 1) % #THEMES + 1]

    skyGrad.Color = ColorSequence.new(A.top:Lerp(B.top, k), A.bot:Lerp(B.bot, k))
    body.BackgroundColor3 = A.body:Lerp(B.body, k)
    body.Position = UDim2.new(lerpN(A.bx, B.bx, k), 0, 0, lerpN(A.by, B.by, k))
    road.BackgroundColor3 = A.road:Lerp(B.road, k)

    local bldCol = A.bld:Lerp(B.bld, k)
    for _, b in ipairs(buildings) do b.BackgroundColor3 = bldCol end

    local winTrans = 1 - lerpN(A.win, B.win, k)
    for _, w in ipairs(windows) do w.BackgroundTransparency = winTrans end

    local starVis = lerpN(A.star, B.star, k)
    for _, s in ipairs(stars) do
        local tw = 0.5 + 0.45 * math.sin(t * 3 + s.p)
        s.f.BackgroundTransparency = 1 - (1 - tw) * starVis
    end

    local cloudTrans = 1 - lerpN(A.cloud, B.cloud, k)
    local cloudCol = A.cloudCol:Lerp(B.cloudCol, k)
    for _, c in ipairs(clouds) do
        c.f.BackgroundColor3 = cloudCol
        c.f.BackgroundTransparency = cloudTrans
        c.f.Position = UDim2.new(0, ((c.off + t * c.spd) % 360) - 50, 0, c.f.Position.Y.Offset)
    end

    -- border RGB, aspal (arah udah dibalik), truk goyang
    strokeGrad.Rotation = (t * 60) % 360
    for i, d in ipairs(dashes) do
        d.Position = UDim2.new(0, ((i - 1) * 40 + t * 70) % 320 - 30, 0, 10)
    end
    truckIcon.Position = UDim2.new(0.5, -14, 0, 56 + math.sin(t * 12))
end)

