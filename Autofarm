local function make(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end

local function bind(signal, fn)
    local c = signal:Connect(fn)
    table.insert(conns, c)
    return c
end

local function lerpN(a, b, k) return a + (b - a) * k end
local function smooth(k) return k * k * (3 - 2 * k) end
local function desat(c, amt)
    local l = c.R * 0.3 + c.G * 0.59 + c.B * 0.11
    return c:Lerp(Color3.new(l, l, l), amt)
end

local function formatRp(n)
    n = math.floor(n + 0.5)
    if n >= 1000000000 then
        return (string.format("Rp %.2f M", n / 1000000000):gsub("%.", ","))
    end
    local s = tostring(n)
    local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
    if out:sub(1, 1) == "." then out = out:sub(2) end
    return "Rp " .. out
end

local function parseMoney(text)
    if type(text) ~= "string" then return nil end
    local s = text:gsub(",%d%d?%s*$", "") -- buang desimal ",00"
    s = s:gsub("%D", "")
    if s == "" then return nil end
    return tonumber(s)
end

