local HUD_W, HUD_H, HUD_GAP = 156, 40, 6

local hudHolder = make("Frame", {
    Name = "HUD", Position = UDim2.new(0, HUD_X, 0, HUD_Y),
    Size = UDim2.new(0, HUD_W, 0, 3 * HUD_H + 2 * HUD_GAP),
