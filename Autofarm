                TweenService:Create(popScale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.94}):Play()
                task.wait(0.1)
                if isAutoFarming and not closing then setFull(true) end
