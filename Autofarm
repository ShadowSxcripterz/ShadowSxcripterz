-- 5. LOOP AUTO-FARMING
-- ========================================================
local function autoFarmLoop()
    while isAutoFarming do
        executeTeleport()
        while isTeleporting and isAutoFarming do task.wait(1) end
        
        if isAutoFarming then
            notify("⏳ Sampai tujuan! Menunggu 5 detik...")
            btn.Text = "JEDA 5s..."
            local waited = 0
            while waited < PAUSE_TIME and isAutoFarming do
                readLastIncome()
                task.wait(0.5)
                waited += 0.5
            end
            if isAutoFarming then btn.Text = "STOP AUTO FARMING" end
        end
    end
end

