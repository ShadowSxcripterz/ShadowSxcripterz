local function executeTeleport()
    if isTeleporting then return end

    local wp = workspace:FindFirstChild("Etc") and workspace.Etc:FindFirstChild("Waypoint") and workspace.Etc.Waypoint:FindFirstChild("Waypoint")
    if not wp or not wp:IsA("BasePart") then
        if isAutoFarming then notify("❌ Waypoint gak ketemu! Auto-Farm berhenti.") end
        isAutoFarming = false
        btn.Text = "MULAI AUTO FARMING"
        btn.BackgroundColor3 = Color3.fromRGB(170, 0, 255)
        return
    end

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or not hum.SeatPart then
        if isAutoFarming then notify("⚠️ Duduk di mobil dulu!") end
        isAutoFarming = false
        btn.Text = "MULAI AUTO FARMING"
        btn.BackgroundColor3 = Color3.fromRGB(170, 0, 255)
        return
    end

    local truck = hum.SeatPart:FindFirstAncestorOfClass("Model")
    if not truck or not truck.PrimaryPart then return end

    isTeleporting = true
    task.wait(1)

    local primary = truck.PrimaryPart
    local finalOffsetY = heightValue
    if not isUp then finalOffsetY = -heightValue end

    local partsData = {}
    for _, v in pairs(truck:GetDescendants()) do
        if v:IsA("BasePart") then
            table.insert(partsData, {part = v, anchored = v.Anchored, canCollide = v.CanCollide})
            v.CanCollide = false
            v.Anchored = true
            v.AssemblyLinearVelocity = Vector3.zero
            v.AssemblyAngularVelocity = Vector3.zero
        end
    end

    local charRoot = char:FindFirstChild("HumanoidRootPart")
    local charOffset = primary.CFrame:ToObjectSpace(charRoot.CFrame)

    local startPivot = truck:GetPivot()
    local targetPos = wp.Position
    local elapsed = 0
    local switchedToDest = false
    local switchTime = 0
    local oldDestPos = getDestinationPos()
    countdownTime = SAFE_TIME

    while elapsed < SAFE_TIME do
        local dt = RunService.Heartbeat:Wait()
        elapsed += dt
        countdownTime = SAFE_TIME - elapsed
        countdownLabel.Text = string.format("Sisa Waktu: %.1fs", math.max(0, countdownTime))

        -- Kalau user pencet STOP pas mobil lagi jalan, hentikan loop
        if not isAutoFarming then
            isTeleporting = false
            break
        end

        if not switchedToDest then
            local destPos = getDestinationPos()
            if destPos then
                if oldDestPos and (destPos - oldDestPos).Magnitude < 5 then
                    -- Abaikan tujuan lama
                else
                    notify("🔄 Ketemu Checkpoint Baru! Lanjut Perjalanan...")
                    targetPos = destPos
                    startPivot = truck:GetPivot()
                    switchTime = elapsed
                    switchedToDest = true
                end
            end
        end

        local alpha
        if switchTime > 0 then
            alpha = math.clamp((elapsed - switchTime) / (SAFE_TIME - switchTime), 0, 1)
        else
            alpha = math.clamp(elapsed / SAFE_TIME, 0, 1)
        end

        local targetCFrame = CFrame.new(targetPos + Vector3.new(0, finalOffsetY, 0)) * (startPivot - startPivot.Position)
        local currentPivot = startPivot:Lerp(targetCFrame, alpha)

        truck:PivotTo(currentPivot)
        if charRoot and charRoot.Parent then
            charRoot.CFrame = currentPivot * charOffset
        end
    end

    if isAutoFarming then
        local finalPivot = CFrame.new(targetPos + Vector3.new(0, finalOffsetY, 0)) * (startPivot - startPivot.Position)
        truck:PivotTo(finalPivot)
        if charRoot and charRoot.Parent then
            charRoot.CFrame = finalPivot * charOffset
        end

        for i = 1, 60 do
            for _, data in ipairs(partsData) do
                if data.part and data.part.Parent then
                    data.part.AssemblyLinearVelocity = Vector3.zero
                    data.part.AssemblyAngularVelocity = Vector3.zero
                end
            end
            RunService.Heartbeat:Wait()
        end

        for _, data in ipairs(partsData) do
            if data.part and data.part.Parent then
                data.part.AssemblyLinearVelocity = Vector3.zero
                data.part.AssemblyAngularVelocity = Vector3.zero
                data.part.Anchored = data.anchored
            end
            task.wait()
        end

        task.wait(0.3)
        for _, data in ipairs(partsData) do
            if data.part and data.part.Parent then
                data.part.CanCollide = data.canCollide
            end
        end
    end

    countdownLabel.Text = "Sisa Waktu: 0.0s"
    isTeleporting = false
end

