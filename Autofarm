local t0 = os.clock()
local animConn
animConn = RunService.RenderStepped:Connect(function()
    if not gui.Parent then animConn:Disconnect() return end

    -- ukuran banner di ruang lokal (dibagi UIScale pop-in biar akurat)
    local ps = popScale.Scale
    if ps < 0.05 then return end
    local W, H = banner.AbsoluteSize.X / ps, banner.AbsoluteSize.Y / ps
    if H < 10 then return end
    local S = H / 92
    applyScale(S)

    local t = os.clock() - t0
    local u = (t % CYCLE) / CYCLE
    local theta = u * 2 * math.pi
    local rainI, snowI = weatherAt(t)
    local ov = math.max(rainI, snowI)

    -- kepadatan partikel: sebagian di mode kecil, penuh di full screen
    local dens = 0.45 + 0.55 * fullV.Value
    local rainE, snowE = rainI * dens, snowI * dens

    -- matahari & bulan (orbit ikut ukuran banner)
    local cx, hz, ax, ay = W / 2, H * 0.739, W * 0.52, H * 0.63
    sun.Position = UDim2.fromOffset(cx - ax * math.cos(theta), hz - ay * math.sin(theta))
    moon.Position = UDim2.fromOffset(cx - ax * math.cos(theta + math.pi), hz - ay * math.sin(theta + math.pi))
    sun.BackgroundColor3 = ORANGE:Lerp(YELLOW, math.clamp(math.sin(theta) * 2.5, 0, 1))
    sun.BackgroundTransparency = ov * 0.7
    moon.BackgroundTransparency = ov * 0.7

    -- tema siang/sore/malam
    local seg = math.floor(u * 4)
    local k = smooth(u * 4 - seg)
    local A = KEYS[seg + 1]
    local B = KEYS[(seg + 1) % 4 + 1]

    local top = desat(A.top:Lerp(B.top, k), ov * 0.6)
    local bot = desat(A.bot:Lerp(B.bot, k), ov * 0.6)
    top = top:Lerp(Color3.new(0, 0, 0), rainI * 0.25):Lerp(WHITE_C, snowI * 0.12)
    bot = bot:Lerp(Color3.new(0, 0, 0), rainI * 0.2):Lerp(WHITE_C, snowI * 0.15)
    skyGrad.Color = ColorSequence.new(top, bot)

    local roadCol = A.road:Lerp(B.road, k)
    roadCol = roadCol:Lerp(Color3.fromRGB(20, 28, 45), rainI * 0.45):Lerp(Color3.fromRGB(215, 222, 235), snowI * 0.4)
    road.BackgroundColor3 = roadCol

    local bldCol = desat(A.bld:Lerp(B.bld, k), ov * 0.5)
    bldCol = bldCol:Lerp(WHITE_C, snowI * 0.12)
    for _, b in ipairs(buildings) do b.BackgroundColor3 = bldCol end

    local winTrans = 1 - lerpN(A.win, B.win, k)
    for _, w in ipairs(windows) do w.BackgroundTransparency = winTrans end

    local starVis = lerpN(A.star, B.star, k) * (1 - ov * 0.85)
    for _, s in ipairs(stars) do
        local tw2 = 0.5 + 0.45 * math.sin(t * 3 + s.p)
        s.f.BackgroundTransparency = 1 - (1 - tw2) * starVis
    end

    local cloudTrans = lerpN(1 - lerpN(A.cloud, B.cloud, k), 0.1, ov)
    local cloudCol = desat(A.cloudCol:Lerp(B.cloudCol, k), ov * 0.7):Lerp(Color3.new(0, 0, 0), rainI * 0.35)
    local period = W * 1.25
    for _, c in ipairs(clouds) do
        c.f.BackgroundColor3 = cloudCol
        c.f.BackgroundTransparency = cloudTrans
        local x = ((c.off / 340) * period + t * c.spd * S) % period - W * 0.17
        c.f.Position = UDim2.new(0, x, c.y, 0)
    end

    -- hujan (miring searah jalan)
    for _, d in ipairs(drops) do
        local yf = (t * d.spd / 92 + d.off / 100) % 1.14 - 0.09
        local y = yf * H
        d.f.Position = UDim2.fromOffset((d.xf * W + y * 0.21) % (W * 1.04), y)
        d.f.BackgroundTransparency = 1 - 0.65 * math.clamp((rainE - d.thr * 0.9) * 5, 0, 1)
    end

    -- salju
    for _, f in ipairs(flakes) do
        local yf = (t * f.spd / 100 + f.off / 100) % 1.06 - 0.06
        f.f.Position = UDim2.fromOffset(f.xf * W + math.sin(t * 1.4 + f.p) * 7 * S, yf * H)
        f.f.BackgroundTransparency = 1 - 0.9 * math.clamp((snowE - f.thr * 0.9) * 5, 0, 1)
    end

    -- elemen lain
    strokeGrad.Rotation = (t * 60) % 360
    for i, d in ipairs(dashes) do
        d.Position = UDim2.new(0, ((i - 1) * 40 * S + t * 70 * S) % (320 * S) - 30 * S, 0.5, 0)
    end
    truckIcon.Position = UDim2.new(0.5, 0, 0.6087, math.sin(t * 12) * S)
end)

