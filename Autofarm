local function makeHudCard(title, accent, src, col, rowIdx)
    local x = col * (HUD_W + HUD_GAP)
    local y = (rowIdx - 1) * (HUD_H + HUD_GAP)
    local g = make("CanvasGroup", {
        Size = UDim2.new(0, HUD_W, 0, HUD_H),
        Position = UDim2.new(0, -(HUD_W + 20), 0, y),
        BackgroundColor3 = Color3.fromRGB(14, 14, 24), BackgroundTransparency = 0.12,
        BorderSizePixel = 0, GroupTransparency = 1, Visible = false,
    }, hudHolder)
    make("UICorner", {CornerRadius = UDim.new(0, 8)}, g)
    make("UIStroke", {Color = Color3.fromRGB(60, 60, 95), Thickness = 1}, g)
    make("Frame", {Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = accent, BorderSizePixel = 0}, g)
    make("TextLabel", {
        Size = UDim2.new(1, -18, 0, 12), Position = UDim2.new(0, 12, 0, 5),
        BackgroundTransparency = 1, Text = title, TextColor3 = Color3.fromRGB(150, 150, 185),
        Font = Enum.Font.GothamMedium, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
    }, g)
    local val = make("TextLabel", {
        Size = UDim2.new(1, -18, 0, 18), Position = UDim2.new(0, 12, 0, 18),
        BackgroundTransparency = 1, Text = "-", TextColor3 = WHITE,
        Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, g)
    local function upd()
        val.Text = src.Text:match("^[^:]*:%s*(.*)$") or src.Text
        val.TextColor3 = src.TextColor3
    end
    bind(src:GetPropertyChangedSignal("Text"), upd)
    bind(src:GetPropertyChangedSignal("TextColor3"), upd)
    upd()
    table.insert(hudCards, {g = g, x = x, y = y})
end
