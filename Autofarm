local MALAM = {
    top = Color3.fromRGB(45, 10, 90), bot = Color3.fromRGB(10, 20, 60),
    bld = Color3.fromRGB(18, 14, 35), road = Color3.fromRGB(28, 28, 36),
    star = 1, win = 1, cloud = 0, cloudCol = Color3.fromRGB(120, 110, 160),
}

local KEYS = {SORE, SIANG, SORE, MALAM}
local CYCLE = 40
local CENTER_X, HORIZON = 144, 68
local ARC_X, ARC_Y = 150, 58

local function orbPos(a)
    return UDim2.fromOffset(CENTER_X - ARC_X * math.cos(a), HORIZON - ARC_Y * math.sin(a))
end
local function lerpN(a, b, k) return a + (b - a) * k end
local function smooth(k) return k * k * (3 - 2 * k) end
local function desat(c, amt)
    local l = c.R * 0.3 + c.G * 0.59 + c.B * 0.11
    return c:Lerp(Color3.new(l, l, l), amt)
end

local ORANGE = Color3.fromRGB(255, 140, 60)
local YELLOW = Color3.fromRGB(255, 238, 110)
local WHITE_C = Color3.fromRGB(255, 255, 255)

-- ===== JADWAL CUACA (atur durasi di sini) =====
local SCHEDULE = {
    {"cerah", 30}, {"hujan", 25}, {"cerah", 30}, {"salju", 25},
}
local FADE = 6
local W_TOTAL = 0
for _, s in ipairs(SCHEDULE) do W_TOTAL += s[2] end

local function weatherAt(t)
    local m = t % W_TOTAL
    for _, s in ipairs(SCHEDULE) do
        if m < s[2] then
            local f = smooth(math.clamp(math.min(m / FADE, (s[2] - m) / FADE), 0, 1))
            return (s[1] == "hujan") and f or 0, (s[1] == "salju") and f or 0
        end
        m -= s[2]
    end
    return 0, 0
end

-- partikel (pool tetap, di-recycle)
