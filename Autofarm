-- 4. LOOP AUTO-FARMING & START/STOP
-- ==========================================
local PAUSE_TIME = 5     -- lama jeda setelah sampai tujuan
local SCAN_INTERVAL = 0.5 -- struk discan tiap 0.5 detik selama jeda

local function autoFarmLoop()
    while isAutoFarming do
        executeTeleport()
        
        while isTeleporting and isAutoFarming do
            task.wait(1)
        end
        
        if isAutoFarming then
            notify("⏳ Sampai tujuan! Menunggu 5 detik...")

            -- Selama jeda 5 detik, scanner struk jalan terus
            local waited = 0
            while waited < PAUSE_TIME and isAutoFarming do
                readLastIncome()
                btn.Text = string.format("JEDA %ds...", math.ceil(PAUSE_TIME - waited))
                task.wait(SCAN_INTERVAL)
                waited += SCAN_INTERVAL
            end
            
            if isAutoFarming then
                btn.Text = "STOP AUTO FARMING"
            end
        end
    end
end

