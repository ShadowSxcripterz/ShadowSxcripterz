local function getTransList()
    local ok, list = pcall(function()
        return LP.PlayerGui["ACTUAL NEW PHONE"].Container.Holder.AppContainer.MyBca.AccountTransactions.AmountForm.TransList
    end)
    if ok and list then return list end
    return nil
end

local function amountOf(item)
    return readText(item:FindFirstChild("Amount"))
end

local knownTrans = {}
local saldoBefore = nil

local function snapshotTransactions()
    knownTrans = {}
    local list = getTransList()
    if list then
        for _, c in ipairs(list:GetChildren()) do
            if c.Name == "TransItem" then knownTrans[c] = amountOf(c) or "" end
        end
    end
    local st = readSaldoRaw()
    saldoBefore = st and parseMoney(st) or nil
end

-- cari TransItem baru, atau TransItem lama yang Amount-nya berubah
local function findNewTransaction()
    local list = getTransList()
    if not list then return nil end
    for _, c in ipairs(list:GetChildren()) do
        if c.Name == "TransItem" then
            local prev = knownTrans[c]
            local cur = amountOf(c)
            if prev == nil then
                return c
            elseif cur and cur ~= "" and cur ~= prev then
                return c
            end
        end
    end
    return nil
end

local function readStableAmount(item, id)
    task.wait(0.3)
    local deadline = os.clock() + 3
    local last
    while os.clock() < deadline and alive(id) do
        local cur = amountOf(item)
        if cur and cur ~= "" then
            if cur == last then return cur end
            last = cur
        end
        task.wait(0.25)
    end
    return last
end

local function registerIncome(text, value)
    incomeLabel.Text = "Struk Terakhir: " .. tostring(text)
    incomeLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    if value and value > 0 then totalIncome = totalIncome + value end
    refreshIncomeStats()
end

-- scan TransList.TransItem.Amount selama SCAN_TIME detik setelah sampai tujuan
local function scanIncome(id)
    local startT = os.clock()
    local got = false
    while alive(id) and os.clock() - startT < SCAN_TIME do
        if not got then
            local item = findNewTransaction()
            if item then
                local txt = readStableAmount(item, id)
                if txt then
                    got = true
                    knownTrans[item] = txt
                    local val = parseMoney(txt)
                    if txt:match("^%s*%-") then val = nil end -- minus = pengeluaran, bukan pendapatan
                    registerIncome(txt, val)
                end
            end
        end
        task.wait(0.2)
    end
    if not alive(id) then return end

    -- cadangan: struk dipakai ulang dengan nominal sama -> hitung dari selisih saldo
    if not got then
        local st = readSaldoRaw()
        local nowBal = st and parseMoney(st) or nil
        if nowBal and saldoBefore and nowBal > saldoBefore then
            local delta = nowBal - saldoBefore
            got = true
            registerIncome(formatRp(delta), delta)
        end
    end
    if not got then incomeLabel.TextColor3 = Color3.fromRGB(150, 150, 150) end
end

