local KEYS = {SORE, SIANG, SORE, MALAM}
local CYCLE = 40

local function lerpN(a, b, k) return a + (b - a) * k end
local function smooth(k) return k * k * (3 - 2 * k) end
local function desat(c, amt)
    local l = c.R * 0.3 + c.G * 0.59 + c.B * 0.11
    return c:Lerp(Color3.new(l, l, l), amt)
end

local ORANGE = Color3.fromRGB(255, 140, 60)
