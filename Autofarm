local function autoFarmLoop()
    while isAutoFarming do
        snapshotTransactions() -- foto isi struk SEBELUM jalan, buat bedain struk baru
        executeTeleport()
        while isTeleporting and isAutoFarming do task.wait(1) end
        
        if isAutoFarming then
            notify("⏳ Sampai tujuan! Menunggu 5 detik...")
            btn.Text = "JEDA 5s..."
            local pauseStart = os.clock()
            local gotIncome = false
            while os.clock() - pauseStart < PAUSE_TIME and isAutoFarming do
                if not gotIncome then
                    local item = findNewTransaction()
                    if item then
                        gotIncome = true
                        local txt = readStableAmount(item)
                        if txt then showIncome(txt) end
                    end
                end
                task.wait(0.2)
            end
            -- kalau gak ada struk baru, nilai lama dibiarin tapi diabuin biar keliatan basi
            if not gotIncome and isAutoFarming then
