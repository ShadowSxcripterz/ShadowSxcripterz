local lastS = -1
local function applyScale(S)
    if lastS > 0 and math.abs(S - lastS) < 0.02 then return end
    lastS = S
    local s2 = math.clamp(S ^ 0.6, 1, 1.5)
    local px = math.max(2, math.floor(2 * S + 0.5))

    for _, s in ipairs(stars) do s.f.Size = UDim2.fromOffset(px, px) end
    for _, w in ipairs(windows) do w.Size = UDim2.fromOffset(px, px) end
    for _, c in ipairs(clouds) do c.f.Size = UDim2.fromOffset(c.w * S, c.h * S) end
    sun.Size = UDim2.fromOffset(18 * S, 18 * S)
    moon.Size = UDim2.fromOffset(16 * S, 16 * S)
    for _, d in ipairs(dashes) do d.Size = UDim2.fromOffset(18 * S, math.max(2, 2 * S)) end
    for _, d in ipairs(drops) do
        d.f.Size = UDim2.fromOffset(math.max(1, math.floor(S * 0.5 + 0.5)), 7 * S)
    end
    for _, f in ipairs(flakes) do
        local sz = math.max(3, math.floor(3 * S + 0.5))
        f.f.Size = UDim2.fromOffset(sz, sz)
    end
    bannerTruck.root.Size = UDim2.fromOffset(43 * S, 24 * S)

    titleLbl.Size = UDim2.new(1, -44 * s2, 0, 22 * s2)
    titleLbl.Position = UDim2.new(0, 10 * s2, 0, 6 * s2)
    titleLbl.TextSize = math.floor(15 * s2)
    helloLbl.Size = UDim2.new(1, -44 * s2, 0, 16 * s2)
    helloLbl.Position = UDim2.new(0, 10 * s2, 0, 26 * s2)
    helloLbl.TextSize = math.floor(12 * s2)
    closeBtn.Size = UDim2.fromOffset(24 * s2, 24 * s2)
    closeBtn.Position = UDim2.new(1, -34 * s2, 0, 15 * s2)
    closeBtn.TextSize = math.floor(13 * s2)
end

-- Semua gerak pakai "fase" yang naik per detik (bukan waktu absolut x ukuran), jadi
-- saat ukuran banner berubah (kecil <-> full) / siklus ganti, posisi tetap nyambung.
local t0 = os.clock()
local lastT = t0
local frameN, themeN = 0, 0
local bScroll, dashPhase, wheelDeg = 0, 0, 0
local rainHidden, snowHidden = false, false
local lastWinTrans = -1
local animConn
animConn = RunService.RenderStepped:Connect(function()
    if not gui.Parent then animConn:Disconnect() return end
    frameN = frameN + 1
    if frameN % 2 ~= 0 then return end -- update tiap 2 frame (hemat baterai)
    local now = os.clock()
    local dt = math.min(now - lastT, 0.1)
    lastT = now
    if not mainFrame.Visible then return end

    local ps = popScale.Scale
    if ps < 0.05 then return end
    local W, H = banner.AbsoluteSize.X / ps, banner.AbsoluteSize.Y / ps
    if H < 10 then return end
    local S = H / 92
    applyScale(S)

    local t = now - t0
    local u = (t % CYCLE) / CYCLE
    local theta = u * 2 * math.pi
    local rainI, snowI = weatherAt(t)
    local ov = math.max(rainI, snowI)
    local dens = 0.45 + 0.55 * fullV.Value
    local rainE, snowE = rainI * dens, snowI * dens

    -- ===== GERAK (tiap update) =====
    bScroll = (bScroll + dt * 0.06) % BLD_SPAN
    dashPhase = (dashPhase + dt * 70 / 320) % 1
    wheelDeg = (wheelDeg + dt * 830) % 360

    -- gedung bergerak ke kanan, searah jalan; di-wrap di luar layar
    for _, b in ipairs(buildings) do
        local x = ((b.bf + bScroll) % BLD_SPAN) - BLD_MARGIN
        b.f.Position = UDim2.fromScale(x, 0.7826 - b.hf)
    end
    for i, d in ipairs(dashes) do
        d.Position = UDim2.new(0, ((((i - 1) / 8) + dashPhase) % 1) * 320 * S - 30 * S, 0.5, 0)
    end
    for _, c in ipairs(clouds) do
        c.ph = (c.ph + dt * c.fs) % 1
        local cwpx = c.w * S
        local period = W + 2 * cwpx
        c.f.Position = UDim2.new(0, ((c.off + c.ph) % 1) * period - cwpx, c.y, 0)
    end

    local cx, hz, ax, ay = W / 2, H * 0.739, W * 0.52, H * 0.63
    sun.Position = UDim2.fromOffset(cx - ax * math.cos(theta), hz - ay * math.sin(theta))
    moon.Position = UDim2.fromOffset(cx - ax * math.cos(theta + math.pi), hz - ay * math.sin(theta + math.pi))

    bannerTruck.body.Position = UDim2.fromOffset(0, math.sin(t * 12) * S)
    for _, w in ipairs(bannerTruck.wheels) do w.Rotation = -wheelDeg end
    strokeGrad.Rotation = (t * 60) % 360

    -- hujan / salju (cuma diproses kalau lagi aktif)
    if rainE > 0.001 then
        rainHidden = false
        for _, d in ipairs(drops) do
            local yf = (t * d.spd / 92 + d.off / 100) % 1.14 - 0.09
            local y = yf * H
            d.f.Position = UDim2.fromOffset((d.xf * W + y * 0.21) % (W * 1.04), y)
            d.f.BackgroundTransparency = 1 - 0.65 * math.clamp((rainE - d.thr * 0.9) * 5, 0, 1)
        end
    elseif not rainHidden then
        rainHidden = true
        for _, d in ipairs(drops) do d.f.BackgroundTransparency = 1 end
    end
    if snowE > 0.001 then
        snowHidden = false
        for _, f in ipairs(flakes) do
            local yf = (t * f.spd / 100 + f.off / 100) % 1.06 - 0.06
            f.f.Position = UDim2.fromOffset(f.xf * W + math.sin(t * 1.4 + f.p) * 7 * S, yf * H)
            f.f.BackgroundTransparency = 1 - 0.9 * math.clamp((snowE - f.thr * 0.9) * 5, 0, 1)
        end
    elseif not snowHidden then
        snowHidden = true
        for _, f in ipairs(flakes) do f.f.BackgroundTransparency = 1 end
    end

    -- ===== WARNA / TEMA (tiap 3 update, berubah pelan jadi cukup jarang) =====
    themeN = themeN + 1
    if themeN % 3 ~= 1 then return end

    local seg = math.floor(u * 4)
    local k = smooth(u * 4 - seg)
    local A = KEYS[seg + 1]
    local B = KEYS[(seg + 1) % 4 + 1]

    sun.BackgroundColor3 = ORANGE:Lerp(YELLOW, math.clamp(math.sin(theta) * 2.5, 0, 1))
    sun.BackgroundTransparency = ov * 0.7
    moon.BackgroundTransparency = ov * 0.7

    local top = desat(A.top:Lerp(B.top, k), ov * 0.6)
    local bot = desat(A.bot:Lerp(B.bot, k), ov * 0.6)
    top = top:Lerp(Color3.new(0, 0, 0), rainI * 0.25):Lerp(WHITE_C, snowI * 0.12)
    bot = bot:Lerp(Color3.new(0, 0, 0), rainI * 0.2):Lerp(WHITE_C, snowI * 0.15)
    skyGrad.Color = ColorSequence.new(top, bot)

    local roadCol = A.road:Lerp(B.road, k)
    roadCol = roadCol:Lerp(Color3.fromRGB(20, 28, 45), rainI * 0.45):Lerp(Color3.fromRGB(215, 222, 235), snowI * 0.4)
    road.BackgroundColor3 = roadCol

    local bldCol = desat(A.bld:Lerp(B.bld, k), ov * 0.5)
    bldCol = bldCol:Lerp(WHITE_C, snowI * 0.12)
    for _, b in ipairs(buildings) do b.f.BackgroundColor3 = bldCol end

    local winTrans = 1 - lerpN(A.win, B.win, k)
    if math.abs(winTrans - lastWinTrans) > 0.01 then
        lastWinTrans = winTrans
        for _, w in ipairs(windows) do w.BackgroundTransparency = winTrans end
    end

    local starVis = lerpN(A.star, B.star, k) * (1 - ov * 0.85)
    for _, s in ipairs(stars) do
        local tw2 = 0.5 + 0.45 * math.sin(t * 3 + s.p)
        s.f.BackgroundTransparency = 1 - (1 - tw2) * starVis
    end

    local cloudTrans = lerpN(1 - lerpN(A.cloud, B.cloud, k), 0.1, ov)
    local cloudCol = desat(A.cloudCol:Lerp(B.cloudCol, k), ov * 0.7):Lerp(Color3.new(0, 0, 0), rainI * 0.35)
    for _, c in ipairs(clouds) do
        c.f.BackgroundColor3 = cloudCol
        c.f.BackgroundTransparency = cloudTrans
    end
end)
