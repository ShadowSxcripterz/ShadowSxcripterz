-- ===== TRANSISI GUI KECIL <-> FULL SCREEN =====
-- Otomatis: begitu isAutoFarming jadi true -> melebar full screen,
-- begitu jadi false (stop / gagal) -> balik ke GUI kecil.
local fullV = Instance.new("NumberValue") -- 0 = kecil, 1 = full (buat atur kepadatan hujan/salju)
local isFull = false
local animating = false
local closing = false
local smallPos = mainFrame.Position
local activeTweens = {}
local cardToken, hudToken = 0, 0

mainFrame:GetPropertyChangedSignal("Position"):Connect(function()
    if not isFull and not animating then smallPos = mainFrame.Position end
end)

local function tw(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    table.insert(activeTweens, t)
    return t
end

local function cancelTweens()
    for _, t in ipairs(activeTweens) do t:Cancel() end
    activeTweens = {}
end

local function showHud(on)
    hudToken += 1
    local my = hudToken
    for i, c in ipairs(hudCards) do
        local g = c.g
        local y = (i - 1) * (HUD_H + HUD_GAP)
        if on then
            g.Visible = true
            local d = 0.5 + (i - 1) * 0.1
            tw(g, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, d), {Position = UDim2.new(0, 0, 0, y)})
            tw(g, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, d), {GroupTransparency = 0})
        else
            tw(g, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, (i - 1) * 0.05),
                {Position = UDim2.new(0, -(HUD_W + 20), 0, y), GroupTransparency = 1})
        end
    end
    if not on then
        task.delay(0.7, function()
            if my == hudToken then
                for _, c in ipairs(hudCards) do c.g.Visible = false end
            end
        end)
    end
end

local CTRL_CENTER = (228 + 63) / 360 -- titik tengah panel kontrol (buat posisi di tengah layar)

local function setFull(on)
    isFull = on
    cancelTweens()
    cardToken += 1
    local my = cardToken
    mainFrame.Draggable = false
    animating = true

    local info = TweenInfo.new(on and 0.9 or 0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
    local soft = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local main

    if on then
        mainFrame.Active = false -- sentuhan tembus ke game, tombol tetap bisa dipencet
        main = tw(mainFrame, info, {Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5)})
        tw(mainCorner, info, {CornerRadius = UDim.new(0, 0)})
        tw(stroke, info, {Transparency = 1})
        tw(banner, info, {Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 1, 0)})
        tw(bannerCorner, info, {CornerRadius = UDim.new(0, 0)})
        tw(panel, info, {AnchorPoint = Vector2.new(0.5, CTRL_CENTER), Position = UDim2.fromScale(0.5, 0.52)})
        tw(fullV, info, {Value = 1})
        -- kartu stats di menu menghilang, diganti HUD pojok kiri atas
        tw(card, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 1})
        task.delay(0.4, function() if my == cardToken then card.Visible = false end end)
        tw(ctrl, soft, {BackgroundTransparency = 0.28})
        local fit = math.clamp(gui.AbsoluteSize.Y / 420, 1, 1.3)
        tw(panelScale, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.35), {Scale = fit})
        showHud(true)
    else
        mainFrame.Active = true
        main = tw(mainFrame, info, {Size = UDim2.new(0, 300, 0, 360), Position = smallPos})
        tw(mainCorner, info, {CornerRadius = UDim.new(0, 12)})
        tw(stroke, info, {Transparency = 0})
        tw(banner, info, {Position = UDim2.new(0, 6, 0, 6), Size = UDim2.new(1, -12, 0, 92)})
        tw(bannerCorner, info, {CornerRadius = UDim.new(0, 8)})
        tw(panel, info, {AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0, 0, 0, 0)})
        tw(fullV, info, {Value = 0})
        card.Visible = true
        tw(card, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.3), {GroupTransparency = 0})
        tw(ctrl, soft, {BackgroundTransparency = 1})
        tw(panelScale, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Scale = 1})
        showHud(false)
    end

    -- efek "mantul" kecil di window
    tw(popScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})

    main.Completed:Connect(function(state)
        if state == Enum.PlaybackState.Completed then
            animating = false
            if not on then
                mainFrame.Draggable = true
                smallPos = mainFrame.Position
            end
        end
    end)
end

-- pantau status farming (tanpa nyentuh logic start/stop)
