local toastCount = 0
local TOAST_RED = Color3.fromRGB(235, 60, 70)
local TOAST_YELLOW = Color3.fromRGB(255, 190, 40)
local TOAST_GREEN = Color3.fromRGB(60, 220, 120)
local TOAST_CYAN = Color3.fromRGB(0, 200, 255)
local TOAST_PURPLE = Color3.fromRGB(170, 90, 255)

local function showToast(text, duration)
    if closing or not gui.Parent then return end
    text = tostring(text)
    local dur = duration or 3
    local accent = TOAST_PURPLE
    if text:find("❌", 1, true) or text:find("🛑", 1, true) then
        accent = TOAST_RED; dur = math.max(dur, 5)
    elseif text:find("⚠", 1, true) then
        accent = TOAST_YELLOW; dur = math.max(dur, 4)
    elseif text:find("✅", 1, true) or text:find("🚀", 1, true) then
        accent = TOAST_GREEN
    elseif text:find("🔄", 1, true) or text:find("⏳", 1, true) then
        accent = TOAST_CYAN
    end

    toastCount += 1
    local holderW = toastHolder.AbsoluteSize.X
    if holderW < 100 then holderW = 300 end
    local ts = TextService:GetTextSize(text, 13, Enum.Font.GothamMedium, Vector2.new(holderW - 30, 1000))
    local h = math.max(40, ts.Y + 22)

    local wrapper = make("Frame", {
        Name = "ToastWrap", Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 1,
        LayoutOrder = -toastCount, ZIndex = 100, Active = false,
    }, toastHolder)

    local inner = make("CanvasGroup", {
        Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, -22),
        BackgroundColor3 = Color3.fromRGB(16, 16, 26), BorderSizePixel = 0,
        GroupTransparency = 1, ZIndex = 100,
    }, wrapper)
    make("UICorner", {CornerRadius = UDim.new(0, 10)}, inner)
    make("UIStroke", {Color = accent, Thickness = 1.5, Transparency = 0.35}, inner)
    make("Frame", {Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = accent, BorderSizePixel = 0, ZIndex = 101}, inner)
    make("TextLabel", {
        Size = UDim2.new(1, -24, 1, 0), Position = UDim2.new(0, 16, 0, 0),
        BackgroundTransparency = 1, Text = text, TextColor3 = WHITE, TextWrapped = true,
        Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 101,
    }, inner)
    local bar = make("Frame", {
        Size = UDim2.new(1, 0, 0, 2), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = accent, BorderSizePixel = 0, ZIndex = 102,
    }, inner)

    -- maksimal 4 notif sekaligus, yang paling lama dibuang
    local waps = {}
    for _, c in ipairs(toastHolder:GetChildren()) do
        if c.Name == "ToastWrap" then table.insert(waps, c) end
    end
    if #waps > 4 then
