local function readLastIncome()
    local ok, income = pcall(function()
        local phone = LP.PlayerGui:FindFirstChild("ACTUAL NEW PHONE")
        if not phone or not phone.Enabled then return "HP Tertutup" end

        local transList = phone.Container.Holder.AppContainer.MyBca.AccountTransactions.AmountForm.TransList
        local transItem = transList:FindFirstChild("TransItem")
        if not transItem then return "Belum ada TransItem" end

        local amountObj = transItem:FindFirstChild("Amount")
        if not amountObj then return "Amount Gak Ketemu" end

        if amountObj:IsA("TextLabel") then
            return amountObj.Text
        elseif amountObj:IsA("ValueBase") then
            return tostring(amountObj.Value)
        end
        return tostring(amountObj.Text or amountObj.Value or "?")
    end)

    if ok then
        incomeLabel.Text = "Struk Terakhir: " .. tostring(income)
        incomeLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    else
        incomeLabel.Text = "Struk Terakhir: (Gagal baca)"
        incomeLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end

