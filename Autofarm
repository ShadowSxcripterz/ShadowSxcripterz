local function notify(text, duration)
    pcall(function() StarterGui:SetCore("SendNotification", {Title = "Auto-Pilot", Text = text, Duration = duration or 3}) end)
end

local function getDestinationPos()
    local destFolder = workspace:FindFirstChild("Etc") and workspace.Etc:FindFirstChild("Job") and workspace.Etc.Job:FindFirstChild("Truck") and workspace.Etc.Job.Truck:FindFirstChild("Destination")
    if destFolder then
        for _, v in pairs(destFolder:GetDescendants()) do
            if v:IsA("BasePart") then return v.Position
            elseif v:IsA("Model") and v.PrimaryPart then return v.PrimaryPart.Position
            elseif v:IsA("Vector3Value") then return v.Value end
        end
    end
    return nil
end

local function autoSelectJob()
    print("🤖 Menembak Remote Event Job...")
    pcall(function()
        local jobRemote = ReplicatedStorage:FindFirstChild("NetworkContainer") and ReplicatedStorage.NetworkContainer:FindFirstChild("RemoteEvents") and ReplicatedStorage.NetworkContainer.RemoteEvents:FindFirstChild("Job")
        if jobRemote then
            jobRemote:FireServer("Truck")
            print("✅ Berhasil menembak Remote Job ('Truck')")
        else
            print("❌ Remote Event 'Job' gak ketemu.")
        end
    end)
end

local function tweenPlayerTo(targetPos, duration)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hrp then return end

    if hum then
        hum.Sit = false
        hum.Jump = true
        task.wait(0.3)
    end

    hrp.Anchored = true
    local startCFrame = hrp.CFrame
    local targetCFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    local cframeValue = Instance.new("CFrameValue")
    cframeValue.Value = startCFrame

    local conn = cframeValue.Changed:Connect(function(v)
        if char and char.Parent then char:PivotTo(v) end
    end)

    local tween = TweenService:Create(cframeValue, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Value = targetCFrame})
    tween:Play()
    tween.Completed:Wait()

    cframeValue:Destroy()
    conn:Disconnect()
    
    -- 🔥 PENGAMAN: Paksa lepas anchor walau tween gagal
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.Anchored = false
    end)
end

local function firePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    local oldLos = prompt.RequiresLineOfSight
    local oldDist = prompt.MaxActivationDistance
    
    prompt.RequiresLineOfSight = false
    prompt.MaxActivationDistance = 100
    local ok = pcall(function() fireproximityprompt(prompt) end)
    
    task.wait(1) -- 🔥 Jeda 1 detik biar prompt bener-bener ke-fire di server
    prompt.RequiresLineOfSight = oldLos
    prompt.MaxActivationDistance = oldDist
    return ok
end

