-- lerp linear ke target; bisa dibatalkan, anchor HRP SELALU dilepas di akhir
local function tweenPlayerTo(id, targetPos, duration)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hrp then return false end

    if hum then
        hum.Sit = false
        hum.Jump = true
        task.wait(0.3)
    end

    hrp.Anchored = true
    local startCFrame = hrp.CFrame
    local targetCFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
    local el = 0
    local ok = pcall(function()
        while el < duration do
            if not alive(id) then break end
            el = el + RunService.Heartbeat:Wait()
            char:PivotTo(startCFrame:Lerp(targetCFrame, math.min(el / duration, 1)))
        end
    end)
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.Anchored = false
    end)
    return ok and alive(id)
end

-- aktifkan ProximityPrompt (dekati, fire, pulihkan properti)
local function activatePrompt(id, prompt, settle)
    local oldLOS, oldDist = prompt.RequiresLineOfSight, prompt.MaxActivationDistance
    local function restore()
        pcall(function()
            prompt.RequiresLineOfSight = oldLOS
            prompt.MaxActivationDistance = oldDist
        end)
    end
    pcall(function()
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 100
    end)

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Sit = false
        hum.Jump = true
        if not waitRun(id, 0.5) then restore() return false end
    end

    char = LP.Character
    local part = prompt.Parent
    local pos
    if part and part:IsA("BasePart") then pos = part.Position
    elseif part and part:IsA("Model") then pos = part:GetPivot().Position end
    if char and pos then pcall(function() char:MoveTo(pos) end) end

    if not waitRun(id, 1) then restore() return false end
    pcall(function() fireproximityprompt(prompt) end)
    local okWait = waitRun(id, settle)
    restore()
    return okWait
end

-- ===== TELEPORT TRUCK =====
local function teleportCore(id, truck, charRoot, wp)
    if not waitRun(id, 1) then return "stopped" end

    local finalOffsetY = isUp and heightValue or -heightValue

    frozenParts = {}
    for _, v in ipairs(truck:GetDescendants()) do
        if v:IsA("BasePart") then
            table.insert(frozenParts, {part = v, anchored = v.Anchored, canCollide = v.CanCollide})
            v.CanCollide = false
            v.Anchored = true
            v.AssemblyLinearVelocity = Vector3.zero
            v.AssemblyAngularVelocity = Vector3.zero
        end
    end

    -- pakai pivot model, jadi tidak butuh PrimaryPart
    local startPivot = truck:GetPivot()
    local charOffset = startPivot:ToObjectSpace(charRoot.CFrame)
    local targetPos = wp.Position
    local elapsed = 0
    local switchedToDest = false
    local switchTime = 0
    local oldDestPos = getDestinationPos()

    while elapsed < SAFE_TIME do
        local dt = RunService.Heartbeat:Wait()
        if not alive(id) then return "stopped" end
        elapsed = elapsed + dt
        countdownLabel.Text = string.format("Sisa Waktu: %.1fs", math.max(0, SAFE_TIME - elapsed))

        if not switchedToDest then
            local destPos = getDestinationPos()
            if destPos then
                if oldDestPos and (destPos - oldDestPos).Magnitude < 5 then
                    -- abaikan tujuan lama
                else
                    notify("🔄 Ketemu Checkpoint Baru! Lanjut Perjalanan...")
                    targetPos = destPos
                    startPivot = truck:GetPivot()
                    switchTime = elapsed
                    switchedToDest = true
                end
            end
        end

        local alpha
        if switchTime > 0 then
            alpha = math.clamp((elapsed - switchTime) / (SAFE_TIME - switchTime), 0, 1)
        else
            alpha = math.clamp(elapsed / SAFE_TIME, 0, 1)
        end

        local targetCFrame = CFrame.new(targetPos + Vector3.new(0, finalOffsetY, 0)) * (startPivot - startPivot.Position)
        local currentPivot = startPivot:Lerp(targetCFrame, alpha)
        truck:PivotTo(currentPivot)
        if charRoot.Parent then charRoot.CFrame = currentPivot * charOffset end
    end

    local finalPivot = CFrame.new(targetPos + Vector3.new(0, finalOffsetY, 0)) * (startPivot - startPivot.Position)
    truck:PivotTo(finalPivot)
    if charRoot.Parent then charRoot.CFrame = finalPivot * charOffset end

    for _ = 1, 60 do
        for _, d in ipairs(frozenParts) do
            if d.part and d.part.Parent then
                d.part.AssemblyLinearVelocity = Vector3.zero
                d.part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        RunService.Heartbeat:Wait()
        if not alive(id) then return "stopped" end
    end
    return "done"
end

local function executeTeleport(id)
    if isTeleporting then return "busy" end

    local wp = workspace:FindFirstChild("Etc") and workspace.Etc:FindFirstChild("Waypoint")
        and workspace.Etc.Waypoint:FindFirstChild("Waypoint")
    if not wp or not wp:IsA("BasePart") then
        stopFarm("❌ Waypoint gak ketemu! Auto-Farm berhenti.", id)
        return "error"
    end

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local charRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hum.SeatPart or not charRoot then
        stopFarm("⚠️ Duduk di mobil dulu!", id)
        return "error"
    end

    local truck = hum.SeatPart:FindFirstAncestorOfClass("Model")
    if not truck then
        stopFarm("❌ Model mobil gak ketemu! Auto-Farm berhenti.", id)
        return "error"
    end

    isTeleporting = true
    local ok, res = pcall(teleportCore, id, truck, charRoot, wp)
    restoreTruck()          -- SELALU dipulihkan: selesai, stop manual, atau error
    isTeleporting = false
    countdownLabel.Text = "Sisa Waktu: 0.0s"

    if not ok then
        stopFarm("❌ Error saat teleport, Auto-Farm berhenti.", id)
        return "error"
    end
    return res
end

-- ===== LOOP AUTO-FARMING =====
local function autoFarmLoop(id)
    while alive(id) do
        snapshotTransactions()
        local result = executeTeleport(id)
        if not alive(id) then break end
        if result == "busy" then
            if not waitRun(id, 0.5) then break end
        elseif result ~= "done" then
            break
        else
            notify("⏳ Sampai tujuan! Scan struk " .. SCAN_TIME .. " detik...")
            setBtn("SCAN STRUK " .. SCAN_TIME .. "s...")
            scanIncome(id)
            if alive(id) then setBtn("STOP AUTO FARMING") end
        end
    end
end

-- ===== URUTAN FASE START =====
local function startSequence(id)
    local function fail(msg) stopFarm(msg, id) end

    if not hasFPP then
        fail("❌ Executor tidak mendukung fireproximityprompt!")
        return
    end

    local lw = 0
    while isTeleporting and lw < 5 do task.wait(0.1) lw = lw + 0.1 end

    -- FASE 1: REMOTE JOB
    setBtn("MENGAMBIL JOB...")
    autoSelectJob()
    if not waitRun(id, 2) then return end

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not hum or not hrp then
        fail("❌ Karakter tidak ditemukan!")
        return
    end

    -- FASE 2: KE WAYPOINT, LALU STARTER
    setBtn("MELUNCUR KE STARTER...")
    local waypoint = workspace:FindFirstChild("Etc") and workspace.Etc:FindFirstChild("Waypoint")
        and workspace.Etc.Waypoint:FindFirstChild("Waypoint")
    if not waypoint or not waypoint:IsA("BasePart") then
        fail("❌ Waypoint tidak ditemukan!")
        return
    end

    hum.Sit = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    if not waitRun(id, 0.3) then return end

    if not tweenPlayerTo(id, waypoint.Position, 3) then
        if alive(id) then fail("❌ Tween ke Waypoint gagal!") end
        return
    end

    local starterPrompt = workspace:FindFirstChild("Etc") and workspace.Etc:FindFirstChild("Job")
        and workspace.Etc.Job:FindFirstChild("Truck") and workspace.Etc.Job.Truck:FindFirstChild("Starter")
        and workspace.Etc.Job.Truck.Starter:FindFirstChild("Prompt")
    if starterPrompt and starterPrompt:IsA("ProximityPrompt") then
        if not activatePrompt(id, starterPrompt, 1) then return end
    else
        notify("⚠️ Starter Prompt tidak ditemukan, lanjut ke Spawner...")
    end
    if not waitRun(id, 2) then return end

    -- FASE 3: SPAWNER
    setBtn("MENUJU SPAWNER...")
    local spawnerPart = workspace:FindFirstChild("Etc") and workspace.Etc:FindFirstChild("Job")
        and workspace.Etc.Job:FindFirstChild("Truck") and workspace.Etc.Job.Truck:FindFirstChild("Spawner")
        and workspace.Etc.Job.Truck.Spawner:FindFirstChild("Part")
    if not spawnerPart or not spawnerPart:IsA("BasePart") then
        fail("❌ Spawner.Part tidak ditemukan!")
        return
    end

    if not tweenPlayerTo(id, spawnerPart.Position, 3) then
        if alive(id) then fail("❌ Tween ke Spawner gagal!") end
        return
    end

    local spawnerPrompt = spawnerPart:FindFirstChild("Prompt")
    if not spawnerPrompt or not spawnerPrompt:IsA("ProximityPrompt") then
        fail("❌ Spawner Prompt tidak ditemukan!")
        return
    end

    setBtn("MENGAKTIFKAN SPAWNER...")
    if not activatePrompt(id, spawnerPrompt, 2) then return end

    -- tunggu mobil spawn (maks 20 detik)
    setBtn("MENUNGGU MOBIL SPAWN...")
    local carReady = false
    local waited = 0
    while waited < 20 do
        local vf = workspace:FindFirstChild("Vehicles")
        local car = vf and vf:FindFirstChild(LP.Name .. "sCar")
        if car and car:FindFirstChild("DriveSeat") then
            carReady = true
            break
        end
        if not waitRun(id, 0.5) then return end
        waited = waited + 0.5
    end
    if not carReady then
        fail("❌ Mobil gak muncul setelah 20 detik! Auto-Farm dibatalkan.")
        return
    end
    if not waitRun(id, 1.5) then return end

    -- FASE 4: NAIK KE MOBIL (fire ulang tiap 3 detik sampai duduk)
    setBtn("NAIK KE MOBIL...")
    char = LP.Character
    hum = char and char:FindFirstChildOfClass("Humanoid")
    local vf = workspace:FindFirstChild("Vehicles")
    local myCar = vf and vf:FindFirstChild(LP.Name .. "sCar")
    local driveSeat = myCar and myCar:FindFirstChild("DriveSeat")
    if not hum or not driveSeat then
        fail("❌ Mobil atau karakter tidak ditemukan!")
        return
    end

    local seated = false
    local elapsed, lastFire = 0, -10
    while elapsed < 60 do
        if hum.SeatPart then
            seated = true
            break
        end
        if elapsed - lastFire >= 3 then
            lastFire = elapsed
            pcall(function() driveSeat:Sit(hum) end)
            local prompt = driveSeat:FindFirstChild("PromptDriveSeat")
            if prompt then pcall(function() fireproximityprompt(prompt) end) end
        end
        if not waitRun(id, 0.5) then return end
        elapsed = elapsed + 0.5
    end
    if not seated then
        fail("❌ Gagal duduk di mobil setelah 1 menit! Auto-Farm dibatalkan.")
        return
    end

    if not waitRun(id, 1.5) then return end

    -- FASE 5: LOOP
    setBtn("STOP AUTO FARMING")
    notify("🚀 Auto-Farming Dimulai!")
    autoFarmLoop(id)
end

