    mainFrame.Visible = true
    popScale.Scale = 0
    TweenService:Create(popScale, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = fitS()}):Play()
end

local function playIntro(onDone)
    local cam = workspace.CurrentCamera
    local vp = (cam and cam.ViewportSize) or Vector2.new(800, 450)
    local H = math.max(vp.Y, 300)
    local truckH = math.clamp(H * 0.17, 56, 140)
    local titleSize = math.clamp(H * 0.085, 24, 56)
    local roadY = 0.64
    local PURPLE = Color3.fromRGB(170, 0, 255)
    local CYAN = Color3.fromRGB(0, 200, 255)

        local ov = make("CanvasGroup", {
        Name = "Intro", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ZIndex = 500, Active = true, GroupTransparency = 1,
    }, gui)
    local bgF = make("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, ov)
    local bgGrad = make("UIGradient", {
        Color = ColorSequence.new(Color3.fromRGB(28, 10, 56), Color3.fromRGB(6, 12, 34)), Rotation = 90,
    }, bgF)
    local ovScale = make("UIScale", {Scale = 1}, ov)

    -- orb cahaya melayang di latar
    local orbCols = {Color3.fromRGB(150, 60, 255), Color3.fromRGB(0, 190, 255), Color3.fromRGB(255, 80, 200)}
    local orbs = {}
    for i = 1, 3 do
        local d = H * (0.5 + 0.12 * i)
        local o = make("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(d, d),
            Position = UDim2.fromScale(0.2 + 0.3 * i, 0.35), BackgroundColor3 = orbCols[i],
            BackgroundTransparency = 0.9, BorderSizePixel = 0,
        }, ov)
        make("UICorner", {CornerRadius = UDim.new(1, 0)}, o)
        orbs[i] = o
    end

    -- garis kecepatan (searah jalan)
    local lines = {}
    for i = 1, 14 do
        local len = rng:NextInteger(60, 180)
        local f = make("Frame", {
            Size = UDim2.fromOffset(len, 2), BackgroundColor3 = Color3.fromRGB(190, 200, 255),
            BackgroundTransparency = rng:NextNumber(0.82, 0.93), BorderSizePixel = 0,
        }, ov)
        lines[i] = {f = f, len = len, y = rng:NextNumber(0.05, 0.58), p = rng:NextNumber(), spd = rng:NextNumber(0.25, 0.7)}
    end

    -- jalan
    local roadH = truckH * 0.55
    local roadF = make("Frame", {
        Position = UDim2.new(0, 0, roadY, 0), Size = UDim2.new(1, 0, 0, roadH),
        BackgroundColor3 = Color3.fromRGB(24, 24, 34), BorderSizePixel = 0,
    }, ov)
    local edge = make("Frame", {
        Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, roadF)
    make("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, PURPLE), ColorSequenceKeypoint.new(0.5, CYAN), ColorSequenceKeypoint.new(1, PURPLE),
        }),
    }, edge)
    local dashW = truckH * 0.4
    local introDashes = {}
    for i = 1, 12 do
        introDashes[i] = make("Frame", {
            Size = UDim2.fromOffset(dashW, 3), BackgroundColor3 = Color3.fromRGB(255, 215, 0),
            BackgroundTransparency = 0.15, BorderSizePixel = 0,
        }, roadF)
    end

    -- truck (masuk dari kanan, jalan ke kiri)
    local tr = buildTruck(ov, true)
    tr.root.Size = UDim2.fromOffset(truckH * 1.8, truckH)
    tr.root.Position = UDim2.new(1.3, 0, roadY, truckH * 0.42)

    -- judul huruf per huruf
    local titleText = "AUTO-FARMING"
    local titleRow = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.12, 0),
        Size = UDim2.new(1, 0, 0, titleSize + 8), BackgroundTransparency = 1,
    }, ov)
    make("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, math.floor(titleSize * 0.05)),
    }, titleRow)
    local letters = {}
    for i = 1, #titleText do
        local l = make("TextLabel", {
            LayoutOrder = i, Size = UDim2.fromOffset(0, titleSize + 8), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1, Text = titleText:sub(i, i), TextColor3 = WHITE,
            Font = Enum.Font.GothamBlack, TextSize = titleSize, TextTransparency = 1,
        }, titleRow)
        local st = make("UIStroke", {Color = PURPLE, Thickness = 2, Transparency = 1}, l)
        local sc = make("UIScale", {Scale = 0.2}, l)
        letters[i] = {f = l, st = st, sc = sc}
    end

    local ul = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.12, titleSize + 12),
        Size = UDim2.new(0, 0, 0, 3), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, ov)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, ul)
    make("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, PURPLE), ColorSequenceKeypoint.new(0.5, CYAN), ColorSequenceKeypoint.new(1, PURPLE),
        }),
    }, ul)
    make("UISizeConstraint", {MaxSize = Vector2.new(420, 3)}, ul)

    local subLbl = make("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.12, titleSize + 22),
        Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, Text = "TRUCK JOB   •   V21",
        TextColor3 = Color3.fromRGB(200, 180, 255), Font = Enum.Font.GothamMedium,
        TextSize = math.clamp(math.floor(H * 0.038), 11, 18), TextTransparency = 1,
    }, ov)

    -- progress
    local statusLbl = make("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.82, 0),
        Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, Text = "",
        TextColor3 = Color3.fromRGB(170, 175, 215), Font = Enum.Font.GothamMedium, TextSize = 12,
    }, ov)
    local track = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.84, 0),
        Size = UDim2.new(0.4, 0, 0, 6), BackgroundColor3 = Color3.fromRGB(34, 34, 56), BorderSizePixel = 0,
    }, ov)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, track)
    make("UISizeConstraint", {MaxSize = Vector2.new(340, 6)}, track)
    local fill = make("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, track)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, fill)
    make("UIGradient", {Color = ColorSequence.new(PURPLE, CYAN)}, fill)

    local hello = make("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.9, 0),
        Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "Halo, " .. LP.Name .. "!",
        TextColor3 = Color3.fromRGB(235, 220, 255), Font = Enum.Font.GothamMedium, TextSize = 13, TextTransparency = 1,
    }, ov)

    local flash = make("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 5,
    }, ov)

    local spd = Instance.new("NumberValue")
    spd.Value = 2.4
    local finished = false
    local hb

    local function finish()
        if finished then return end
        finished = true
        TweenService:Create(ov, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1}):Play()
        TweenService:Create(ovScale, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 1.12}):Play()
        task.delay(0.25, function() pcall(onDone) end)
        task.delay(0.6, function()
            if hb then hb:Disconnect() end
            pcall(function() ov:Destroy() end)
        end)
    end

    -- ketuk layar untuk lewati
    ov.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            finish()
        end
    end)

    local it0 = os.clock()
    local dashPh, wheelDeg = 0, 0
    hb = RunService.Heartbeat:Connect(function(dt)
        if not gui.Parent then hb:Disconnect() return end
        local t = os.clock() - it0
        local sp = spd.Value
        dashPh = (dashPh + dt * 0.5 * sp) % 1
        wheelDeg = (wheelDeg + dt * 700 * sp) % 360
        for _, w in ipairs(tr.wheels) do w.Rotation = -wheelDeg end
        tr.body.Position = UDim2.fromOffset(0, math.sin(t * 14 * sp) * 1.3)
        for i, d in ipairs(introDashes) do
            local x = ((((i - 1) / #introDashes) + dashPh) % 1) * (vp.X + dashW * 2) - dashW
            d.Position = UDim2.new(0, x, 0.55, 0)
        end
        for _, L in ipairs(lines) do
            L.p = (L.p + dt * L.spd * sp) % 1
            L.f.Position = UDim2.new(0, L.p * (vp.X + L.len) - L.len, L.y, 0)
        end
        for i, o in ipairs(orbs) do
            o.Position = UDim2.fromScale(0.2 + 0.3 * i + 0.05 * math.sin(t * 0.6 + i), 0.35 + 0.08 * math.cos(t * 0.5 + i * 2))
        end
        bgGrad.Rotation = 90 + 12 * math.sin(t * 0.4)
        for i, L in ipairs(letters) do
            local k = 0.5 + 0.5 * math.sin(t * 5 - i * 0.55)
            L.f.TextColor3 = WHITE:Lerp(Color3.fromRGB(130, 225, 255), k * 0.8)
        end
    end)
    table.insert(conns, hb)

    local function iwait(sec)
        local s = os.clock()
        while os.clock() - s < sec do
            if finished or not gui.Parent then return false end
            task.wait(0.03)
        end
        return not finished
    end

    task.spawn(function()
        local T0 = os.clock()
        local function at(T) return iwait(math.max(0, T - (os.clock() - T0))) end
        local function setStatus(s) if not finished then statusLbl.Text = s end end

        TweenService:Create(ov, TweenInfo.new(0.35, Enum.EasingStyle.Quad), {GroupTransparency = 0}):Play()
        if not at(0.15) then return end

        -- truck masuk + melambat
        TweenService:Create(tr.root, TweenInfo.new(1.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Position = UDim2.new(0.5, 0, roadY, truckH * 0.42)}):Play()
        TweenService:Create(spd, TweenInfo.new(1.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Value = 0.4}):Play()
        if not at(0.45) then return end

        -- huruf judul
        for i, L in ipairs(letters) do
            task.delay((i - 1) * 0.055, function()
                if finished then return end
                TweenService:Create(L.sc, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
                TweenService:Create(L.f, TweenInfo.new(0.35), {TextTransparency = 0}):Play()
                TweenService:Create(L.st, TweenInfo.new(0.35), {Transparency = 0.35}):Play()
            end)
        end

        -- progress bar
        TweenService:Create(fill, TweenInfo.new(2.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {Size = UDim2.new(1, 0, 1, 0)}):Play()
        setStatus("Memuat modul...")
        if not at(1.2) then return end

        TweenService:Create(ul, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0.34, 0, 0, 3)}):Play()
        TweenService:Create(subLbl, TweenInfo.new(0.5), {TextTransparency = 0.05}):Play()
        TweenService:Create(hello, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
        setStatus("Membangun antarmuka...")
        if not at(1.9) then return end
        setStatus("Menyiapkan environment...")
        if not at(2.6) then return end
        setStatus("Hampir siap...")
        if not at(3.0) then return end

        setStatus("Siap!")
        TweenService:Create(flash, TweenInfo.new(0.12), {BackgroundTransparency = 0.82}):Play()
        task.delay(0.12, function()
            if not finished then TweenService:Create(flash, TweenInfo.new(0.35), {BackgroundTransparency = 1}):Play() end
        end)
        if not at(3.15) then return end

        -- truck tancap gas ke kiri
        TweenService:Create(spd, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Value = 2.6}):Play()
        TweenService:Create(tr.root, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {Position = UDim2.new(-0.4, 0, roadY, truckH * 0.42)}):Play()
        if not at(3.4) then return end
        finish()
    end)
end

playIntro(showMain)
