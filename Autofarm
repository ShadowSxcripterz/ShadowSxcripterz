        BackgroundColor3 = WHITE_C, BackgroundTransparency = 1,
    }, banner)
    make("UICorner", {CornerRadius = UDim.new(1, 0)}, f)
    table.insert(flakes, {f = f, x = rng:NextNumber(0, 288), off = rng:NextNumber(0, 100),
