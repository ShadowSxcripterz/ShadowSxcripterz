            btn.Text = "MULAI AUTO FARMING"
            btn.BackgroundColor3 = Color3.fromRGB(170, 0, 255)
            return
        end

        task.wait(1.5)
        if not isAutoFarming then return end

        -- FASE 5: JALANKAN LOOP
        btn.Text = "STOP AUTO FARMING"
        notify("🚀 Auto-Farming Dimulai!")
        task.spawn(autoFarmLoop)
    end
end)

