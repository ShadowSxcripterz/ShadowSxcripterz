local SCHEDULE = {{"cerah", 30}, {"hujan", 25}, {"cerah", 30}, {"salju", 25}}
local FADE = 6
local W_TOTAL = 0
for _, s in ipairs(SCHEDULE) do W_TOTAL = W_TOTAL + s[2] end

local function weatherAt(t)
    local m = t % W_TOTAL
    for _, s in ipairs(SCHEDULE) do
        if m < s[2] then
            local f = smooth(math.clamp(math.min(m / FADE, (s[2] - m) / FADE), 0, 1))
            return (s[1] == "hujan") and f or 0, (s[1] == "salju") and f or 0
        end
        m = m - s[2]
    end
    return 0, 0
end

