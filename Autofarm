-- ===== DETEKSI STRUK BARU =====
-- Alurnya: sebelum jalan, foto isi TransList (snapshot). Pas udah sampai tujuan,
-- nunggu sampai ada TransItem BARU (atau isinya berubah), baru amount-nya dibaca.
local knownTrans = {}

local function getTransList()
    local ok, list = pcall(function()
        return LP.PlayerGui["ACTUAL NEW PHONE"].Container.Holder.AppContainer.MyBca.AccountTransactions.AmountForm.TransList
    end)
    if ok then return list end
    return nil
end

local function amountOf(item)
    local a = item:FindFirstChild("Amount")
    if not a then return nil end
    if a:IsA("TextLabel") or a:IsA("TextButton") or a:IsA("TextBox") then return a.Text end
    if a:IsA("ValueBase") then return tostring(a.Value) end
    local ok, v = pcall(function() return a.Text or a.Value end)
    if ok and v ~= nil then return tostring(v) end
    return nil
end

local function snapshotTransactions()
    knownTrans = {}
    local list = getTransList()
    if not list then return end
    for _, c in ipairs(list:GetChildren()) do
        if c.Name == "TransItem" then knownTrans[c] = amountOf(c) or "" end
    end
end

local function findNewTransaction()
    local list = getTransList()
    if not list then return nil end
    for _, c in ipairs(list:GetChildren()) do
        if c.Name == "TransItem" then
            local prev = knownTrans[c]
            local cur = amountOf(c)
            if prev == nil then
                return c -- item baru muncul
            elseif cur and cur ~= "" and cur ~= prev then
                return c -- item lama dipakai ulang, isinya berubah
            end
        end
    end
    return nil
end

-- tunggu teks Amount udah keisi dan stabil (dua kali baca sama) sebelum dipakai
local function readStableAmount(item)
    task.wait(0.3)
    local deadline = os.clock() + 3
    local last
    while os.clock() < deadline and isAutoFarming do
        local cur = amountOf(item)
        if cur and cur ~= "" then
            if cur == last then return cur end
            last = cur
        end
        task.wait(0.25)
    end
    return last
end

