local function tw(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    table.insert(activeTweens, t)
    return t
end

local function cancelTweens()
    for _, t in ipairs(activeTweens) do t:Cancel() end
    activeTweens = {}
end

local function applyLayout(layout, info)
    for key, props in pairs(layout) do tw(ctrlParts[key], info, props) end
end

local function showHud(on)
    hudToken = hudToken + 1
    local my = hudToken
    for i, c in ipairs(hudCards) do
        local g = c.g
        if on then
            g.Visible = true
            local d = 0.5 + (i - 1) * 0.08
            tw(g, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, d), {Position = UDim2.new(0, c.x, 0, c.y)})
            tw(g, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, d), {GroupTransparency = 0})
        else
            tw(g, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, (i - 1) * 0.04),
                {Position = UDim2.new(0, -(HUD_W + 20), 0, c.y), GroupTransparency = 1})
        end
    end
    if not on then
        task.delay(0.8, function()
            if my == hudToken then
                for _, c in ipairs(hudCards) do c.g.Visible = false end
            end
        end)
    end
end

local function setFull(on)
    isFull = on
    cancelTweens()
    cardToken = cardToken + 1
    local my = cardToken
    animating = true

    local info = TweenInfo.new(on and 0.9 or 0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
    local main

    if on then
        mainFrame.Active = false -- sentuhan tembus ke game, tombol tetap bisa dipencet
        main = tw(mainFrame, info, {Size = UDim2.fromScale(1, 1), Position = UDim2.fromScale(0.5, 0.5)})
        tw(mainCorner, info, {CornerRadius = UDim.new(0, 0)})
        tw(stroke, info, {Transparency = 1})
        tw(banner, info, {Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 1, 0)})
        tw(bannerCorner, info, {CornerRadius = UDim.new(0, 0)})
        tw(fullV, info, {Value = 1})
        tw(card, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 1})
        task.delay(0.4, function() if my == cardToken then card.Visible = false end end)
        -- kontrol pindah ke kiri atas
        tw(ctrl, info, {
            Position = UDim2.new(0, HUD_X, 0, HUD_Y),
            Size = UDim2.fromOffset(CTRL_FULL_W, CTRL_FULL_H),
            BackgroundTransparency = 0.12,
        })
        tw(ctrlStroke, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0})
        applyLayout(LAYOUT_FULL, info)
        showHud(true)
    else
        mainFrame.Active = true
        main = tw(mainFrame, info, {Size = UDim2.new(0, SMALL_W, 0, SMALL_H), Position = smallPos})
        tw(mainCorner, info, {CornerRadius = UDim.new(0, 12)})
        tw(stroke, info, {Transparency = 0})
        tw(banner, info, {Position = UDim2.new(0, 6, 0, 6), Size = UDim2.new(1, -12, 0, 92)})
        tw(bannerCorner, info, {CornerRadius = UDim.new(0, 8)})
        tw(fullV, info, {Value = 0})
        card.Visible = true
        tw(card, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0.3), {GroupTransparency = 0})
        tw(ctrl, info, {Position = CTRL_SMALL_POS, Size = CTRL_SMALL_SIZE, BackgroundTransparency = 1})
        tw(ctrlStroke, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 1})
        applyLayout(LAYOUT_SMALL, info)
        showHud(false)
    end

    tw(popScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = on and 1 or fitS()})

    main.Completed:Connect(function(state)
        if state == Enum.PlaybackState.Completed and my == cardToken then
            animating = false
            if not on then smallPos = mainFrame.Position end
        end
    end)
end

