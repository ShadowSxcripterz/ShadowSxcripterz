local function alive(id)
    return isAutoFarming and runId == id and not closing and gui.Parent ~= nil
end

local function waitRun(id, sec)
    local start = os.clock()
    while os.clock() - start < sec do
        if not alive(id) then return false end
        task.wait(0.1)
    end
    return alive(id)
end

local function setBtn(text) btn.Text = text end

-- pulihkan truck apa pun kondisinya (selesai normal, stop manual, error, atau script ditutup)
local function restoreTruck(skipWait)
    local data = frozenParts
    if not data then return end
    frozenParts = nil
    for _, d in ipairs(data) do
        local p = d.part
        if p and p.Parent then
            pcall(function()
                p.AssemblyLinearVelocity = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
                p.Anchored = d.anchored
            end)
        end
    end
    if not skipWait then task.wait(0.3) end
    for _, d in ipairs(data) do
        local p = d.part
        if p and p.Parent then pcall(function() p.CanCollide = d.canCollide end) end
    end
end

