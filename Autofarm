local function addPress(button)
    local sc = make("UIScale", {}, button)
    local function up()
        TweenService:Create(sc, TweenInfo.new(0.15, Enum.EasingStyle.Back), {Scale = 1}):Play()
    end
    button.MouseButton1Down:Connect(function()
        TweenService:Create(sc, TweenInfo.new(0.08), {Scale = 0.93}):Play()
    end)
    button.MouseButton1Up:Connect(up)
    button.MouseLeave:Connect(up)
end
